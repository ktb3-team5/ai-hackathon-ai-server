# Google Gemini API
GOOGLE_API_KEY=your-gemini-api-key

# 서버 설정
APP_ENV=development
DEBUG=true
HOST=0.0.0.0
PORT=8000

# Redis (선택 - 세션 영속화용)
REDIS_URL=redis://localhost:6379/0

# CORS (프로덕션에서는 특정 도메인만)
ALLOWED_ORIGINS=http://localhost:3000,https://your-frontend.com

# 모델 설정
GEMINI_MODEL=gemini-1.5-flash
GEMINI_TEMPERATURE=0.7
